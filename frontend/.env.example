# Local development — Vite dev server proxies /api to localhost:4000,
# so VITE_API_BASE_URL can be left empty (the proxy handles it).
VITE_API_BASE_URL=

# PRODUCTION — set this to your deployed backend URL in Vercel's Environment Variables.
# Example: VITE_API_BASE_URL=https://saasquatch-lead-intelligence-api.onrender.com
# Leave no trailing slash.
