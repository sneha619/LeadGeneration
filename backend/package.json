{
  "name": "saasquatch-lead-intelligence-backend",
  "version": "0.1.0",
  "description": "Backend API for SaaSquatch Lead Intelligence",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
